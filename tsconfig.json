{
  "compilerOptions": {
    "target": "ES2023", "module": "Preserve", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts"]
}
