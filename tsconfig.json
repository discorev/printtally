{
  "compilerOptions": {
    "target": "ES2023", "module": "Preserve", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "jsx": "react-jsx",
    "types": ["bun"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.cts", "apps/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts"]
}
