{
  "cleanUrls": true,
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ]; then git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .; elif [ \"$VERCEL_GIT_COMMIT_REF\" = main ]; then false; else git fetch --quiet --depth=100 origin main && git diff --quiet FETCH_HEAD...HEAD -- .; fi",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "ptly.ink" }],
      "destination": "https://printtally.ink/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.ptly.ink" }],
      "destination": "https://printtally.ink/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.printtally.ink" }],
      "destination": "https://printtally.ink/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(favicon.svg|favicon.png|apple-touch-icon.png|og.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ]
}
