{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "plugins": [{ "type": "node-workspace", "updatePeerDependencies": true }],
  "packages": {
    ".": {
      "component": "backend",
      "release-type": "node",
      "changelog-path": "apps/server/CHANGELOG.md",
      "extra-files": [{ "type": "json", "path": "apps/server/package.json", "jsonpath": "$.version" }],
      "exclude-paths": ["apps/desktop", "assets", "docs", "scripts", "tests", ".github"]
    },
    "apps/desktop": {
      "component": "app",
      "release-type": "node"
    }
  }
}
