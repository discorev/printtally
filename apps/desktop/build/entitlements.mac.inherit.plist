<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every other executable in the app: Electron's helpers (V8) and the embedded Bun server
     (Resources/server/printtally-server, JavaScriptCore). Without allow-jit the server still runs,
     but JavaScriptCore silently falls back to its interpreter, about 9x slower. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
