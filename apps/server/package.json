{
  "name": "printtally", "version": "0.1.0", "license": "MIT",
  "description": "Per-job print cost accounting for Canon imagePROGRAF printers",
  "type": "module", "engines": {"bun": ">=1.3.9"},
  "bin": {"printtally": "./src/cli.ts"},
  "files": ["src", "dist/client"],
  "scripts": {
    "build:binary": "bun build --compile src/cli.ts --outfile dist/printtally-server"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "print-accounting-contracts": "workspace:*",
    "print-accounting-core": "workspace:*",
    "print-accounting-database": "workspace:*",
    "print-accounting-ivec": "workspace:*",
    "uqr": "^0.1.3",
    "zod": "^4.0.0"
  }
}
